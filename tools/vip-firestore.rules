    // ===================== MMM V.I.P (paste this block INSIDE: match /databases/{database}/documents { ... }) =====================
    // vipLinks/{token}  private sign-up links made by Max on maxmaserati.com/admin/ (expiry + number of people)
    // vipCodes/{code}   one code per person; status "active" or "revoked"
    // vipEmails/{email} one code per email
    function vipAdmin() {
      return request.auth != null && request.auth.token.email == 'infotrade@maxmaserati.com' && request.auth.token.email_verified == true;
    }
    function vipLinkPath(t) { return /databases/$(database)/documents/vipLinks/$(t); }
    function vipClaimOk(c, d) {
      let L = get(vipLinkPath(d.link)).data;
      return c.size() >= 15 && c.size() <= 24
        && d.keys().hasOnly(['email', 'link', 'key', 'status', 'created', 'note'])
        && d.status == 'active' && d.email is string && d.email.size() >= 6 && d.email.size() <= 120
        && d.created == request.time
        && L.expires > request.time && L.used < L.max
        && d.key == L.key && d.note == L.note
        && getAfter(vipLinkPath(d.link)).data.used == L.used + 1
        && getAfter(/databases/$(database)/documents/vipEmails/$(d.email)).data.code == c;
    }
    match /vipLinks/{t} {
      allow get: if vipAdmin() || resource.data.expires > request.time;
      allow list, create, delete: if vipAdmin();
      // a claim adds exactly 1 to "used", only while the link is live and not full
      allow update: if vipAdmin() || (
        resource.data.expires > request.time && resource.data.used < resource.data.max
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == resource.data.used + 1);
    }
    match /vipCodes/{c} {
      allow get: if vipAdmin() || resource.data.status == 'active';
      allow list, update, delete: if vipAdmin();
      allow create: if vipAdmin() || vipClaimOk(c, request.resource.data);
    }
    match /vipEmails/{e} {
      allow get, list, update, delete: if vipAdmin();
      allow create: if request.resource.data.keys().hasOnly(['code'])
        && getAfter(/databases/$(database)/documents/vipCodes/$(request.resource.data.code)).data.email == e;
    }
    // ===================== MMM prop offers inbox =====================
    // propOffers/{id}  text Max pastes from Grok each morning (public offers seen on X). Anyone can read it
    // (the morning task reads it without a login); only the admin login can add, change or delete.
    match /propOffers/{id} {
      allow get, list: if true;
      allow create: if vipAdmin() && request.resource.data.keys().hasOnly(['text', 'created'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 20000;
      allow update, delete: if vipAdmin();
    }
    // ===================== MMM prop affiliates =====================
    // propAff/{firm}       Max's affiliate link + code for one firm. Anyone can read it (/prop-firms/ shows it); only the admin login can change it.
    // propAffTrack/{firm}  Max's private status + note for each program. Admin only.
    match /propAff/{id} {
      allow get, list: if true;
      allow create, update: if vipAdmin()
        && request.resource.data.keys().hasOnly(['firm', 'url', 'code', 'updated'])
        && request.resource.data.firm is string && request.resource.data.firm.size() <= 80
        && request.resource.data.url is string && request.resource.data.url.size() <= 500
        && (request.resource.data.url == '' || request.resource.data.url.matches('https://[^ "<>]+'))
        && request.resource.data.code is string && request.resource.data.code.matches('[A-Za-z0-9_-]{0,40}');
      allow delete: if vipAdmin();
    }
    match /propAffTrack/{id} {
      allow read, write: if vipAdmin();
    }
    // ===================== MMM prop clicks + money =====================
    // propClicks/{day__plan__size__b|c}  n = how many clicks on a buy button (b) or code copy (c) on /prop-firms/ that day.
    // Anyone can add exactly 1 (no personal data is stored); only the admin login can read or delete.
    match /propClicks/{id} {
      allow get, list, delete: if vipAdmin();
      allow create: if id.matches('20[0-9]{2}-[0-9]{2}-[0-9]{2}__[a-z0-9-]{1,40}__[0-9.]{1,6}__[bc]')
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }
    // propEarn/{id}  affiliate money Max received (date, firm, usd, note). Admin only.
    match /propEarn/{id} {
      allow read, write: if vipAdmin();
    }
    // ===================== end MMM V.I.P =====================
